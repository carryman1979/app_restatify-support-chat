<Page x:Class="Restatify.SupportChat.Presentation.ConversationDetailsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Restatify.SupportChat.Presentation"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  mc:Ignorable="d"
	  Background="{ThemeResource BackgroundBrush}">

	<Page.Resources>
		<local:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
		<Style x:Key="FabSplitButtonStyle" TargetType="SplitButton">
			<Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
			<Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="18" />
			<Setter Property="MinHeight" Value="36" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header with back button -->
		<utu:NavigationBar Grid.Row="0">
			<utu:NavigationBar.MainCommand>
				<AppBarButton Icon="Back" Click="OnBackClick" />
			</utu:NavigationBar.MainCommand>
			<utu:NavigationBar.Content>
				<StackPanel Orientation="Vertical" Spacing="1">
					<TextBlock Text="{Binding ConversationId}" FontSize="14" FontWeight="SemiBold" />
					<TextBlock Text="{Binding SourceUrl}" FontSize="11" Opacity="0.6" />
				</StackPanel>
			</utu:NavigationBar.Content>
		</utu:NavigationBar>

		<!-- Chat Layout -->
		<Grid Grid.Row="1" Padding="16,8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Controls Row -->
			<Grid Grid.Row="0" Margin="0,0,0,8" RowSpacing="6" ColumnSpacing="12">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<ComboBox Grid.Column="0"
							  FontSize="14"
							  MinHeight="36"
							  DisplayMemberPath="Label"
							  SelectedValuePath="Value"
							  ItemsSource="{Binding AiModeOptions}"
							  IsEnabled="{Binding CanInteractWithConversation}"
							  SelectedValue="{Binding SelectedAiMode, Mode=TwoWay}" />
					<Button Grid.Column="1"
							x:Uid="ConversationDetailsPage_SaveAiModeButton"
							Content="KI-Modus speichern"
							IsEnabled="{Binding CanInteractWithConversation}"
							Command="{Binding SaveAiModeCommand}"
							Padding="10,8"
							MinWidth="130" />
				</Grid>

				<Button Grid.Row="0" Grid.Column="1"
						x:Name="LoadMoreArrowButton"
						Width="30"
						Height="26"
						Padding="0"
						Opacity="0.55"
						IsEnabled="{Binding CanInteractWithConversation}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Command="{Binding LoadMoreServerMessagesCommand}"
						Visibility="{Binding HasMoreServerMessages, Converter={StaticResource VisibleWhenTrue}}"
						PointerEntered="OnLoadMoreArrowPointerEntered"
						PointerExited="OnLoadMoreArrowPointerExited"
						GotFocus="OnLoadMoreArrowGotFocus"
						LostFocus="OnLoadMoreArrowLostFocus"
						ToolTipService.ToolTip="Ältere Nachrichten laden">
					<FontIcon Glyph="&#xE74A;" FontSize="11" />
				</Button>

				<Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0"
							   Text="{Binding ServerStatus}"
							   FontSize="12"
							   Opacity="0.7"
							   TextTrimming="CharacterEllipsis"
							   MaxLines="1"
							   VerticalAlignment="Center" />
					<Ellipse Grid.Column="1"
						 Width="10"
						 Height="10"
						 Fill="{Binding LiveUpdatesStatusBrush}"
						 Stroke="{ThemeResource OutlineColor}"
						 StrokeThickness="1"
						 VerticalAlignment="Bottom"
						 HorizontalAlignment="Right"
						 ToolTipService.ToolTip="{Binding LiveUpdatesStatusText}" />
				</Grid>
			</Grid>

			<!-- Message Thread -->
			<ListView Grid.Row="1"
					  x:Name="ServerMessagesListView"
					  ItemsSource="{Binding ServerMessages}"
					  BorderBrush="{ThemeResource OutlineVariantColor}"
					  BorderThickness="1"
					  CornerRadius="8"
					  Background="{ThemeResource SurfaceBrush}">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="Padding" Value="0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate>
						<Grid Padding="14,10"
							  BorderBrush="{ThemeResource OutlineVariantColor}"
							  BorderThickness="0,0,0,1">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Margin="0,0,0,4" ColumnSpacing="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0"
										   Text="{Binding Sender}"
										   FontWeight="SemiBold"
										   FontSize="12"
										   Foreground="{ThemeResource TertiaryColor}"
										   TextTrimming="CharacterEllipsis"
										   MaxLines="1" />
								<TextBlock Grid.Column="1"
										   Text="{Binding TimeGmt}"
										   FontSize="10"
										   Opacity="0.55"
										   HorizontalAlignment="Right"
										   MaxLines="1" />
							</Grid>
							<TextBlock Grid.Row="1"
									   Text="{Binding Message}"
									   TextWrapping="Wrap"
									   FontSize="13" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<!-- Reply Composer -->
			<Border Grid.Row="2"
					Background="{ThemeResource SurfaceBrush}"
					BorderBrush="{ThemeResource OutlineColor}"
					BorderThickness="0,1,0,0"
					Padding="12,10"
					Margin="0,8,0,0">
				<Grid ColumnSpacing="12" RowSpacing="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
							Background="#FFF8E1"
							BorderBrush="#FFE082"
							BorderThickness="1"
							CornerRadius="6"
							Padding="8,6"
							Visibility="{Binding IsConversationDeleted, Converter={StaticResource VisibleWhenTrue}}">
						<TextBlock Text="{Binding ConversationDeletedBannerText}" FontSize="12" />
					</Border>

					<TextBox Grid.Row="1" Grid.Column="0"
							 x:Name="ReplyMessageTextBox"
							 x:Uid="ConversationDetailsPage_ReplyMessageTextBox"
							 Text="{Binding ReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 InputScope="Text"
							 PreventKeyboardDisplayOnProgrammaticFocus="False"
							 PlaceholderText="Antwort eingeben..."
							 KeyDown="OnReplyMessageKeyDown"
							 IsEnabled="{Binding CanInteractWithConversation}"
							 AcceptsReturn="False"
							 MinHeight="60"
							 MaxHeight="120" />
					<SplitButton
							 Grid.Row="1" Grid.Column="1"
							 Style="{StaticResource FabSplitButtonStyle}"
							 Command="{Binding SendReplyCommand}"
							 IsEnabled="{Binding CanInteractWithConversation}"
							 VerticalAlignment="Center"
							 MinWidth="84"
							 Padding="10,8">
						<ToolTipService.ToolTip>Senden</ToolTipService.ToolTip>					
						
						<SymbolIcon Symbol="Send" />
						
						<SplitButton.Flyout>
							<MenuFlyout>
								<MenuFlyoutItem Text="Senden" Command="{Binding SendReplyCommand}" />
								<MenuFlyoutItem Text="Buchungs-Overlay öffnen"
											Command="{Binding OpenBookingOverlayCommand}"
											IsEnabled="{Binding IsBookingOverlayAvailable}" />
								<MenuFlyoutItem Text="Chat löschen" Click="OnDeleteConversationClick" />
							</MenuFlyout>
						</SplitButton.Flyout>
					</SplitButton>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Page>
