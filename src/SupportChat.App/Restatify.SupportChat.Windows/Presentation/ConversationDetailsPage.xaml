<Page x:Class="Restatify.SupportChat.Presentation.ConversationDetailsPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  mc:Ignorable="d"
	  Background="{ThemeResource BackgroundBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header with back button -->
		<utu:NavigationBar Grid.Row="0">
			<utu:NavigationBar.MainCommand>
				<AppBarButton Icon="Back" Click="OnBackClick" />
			</utu:NavigationBar.MainCommand>
			<utu:NavigationBar.Content>
				<StackPanel Orientation="Vertical" Spacing="1">
					<TextBlock Text="{Binding ConversationId}" FontSize="14" FontWeight="SemiBold" />
					<TextBlock Text="{Binding SourceUrl}" FontSize="11" Opacity="0.6" />
				</StackPanel>
			</utu:NavigationBar.Content>
		</utu:NavigationBar>

		<!-- Chat Layout -->
		<Grid Grid.Row="1" Padding="16,8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Controls Row -->
			<Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0"
						x:Uid="ConversationDetailsPage_RefreshButton"
						Content="Aktualisieren"
						Command="{Binding RefreshServerMessagesCommand}"
						Padding="10,7"
						FontSize="13" />
				<Button Grid.Column="1"
						Content="{Binding LoadMoreButtonText}"
						IsEnabled="{Binding HasMoreServerMessages}"
						Command="{Binding LoadMoreServerMessagesCommand}"
						Padding="10,7"
						FontSize="13" />
				<TextBlock Grid.Column="2"
						   Text="{Binding ServerStatus}"
						   VerticalAlignment="Center"
						   FontSize="12"
						   Opacity="0.7"
						   TextTrimming="CharacterEllipsis" />
				<ToggleSwitch Grid.Column="3"
							  x:Uid="ConversationDetailsPage_AutoRefreshToggle"
							  Header="Auto"
							  IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}"
							  VerticalAlignment="Center" />
			</Grid>

			<!-- Message Thread -->
			<ListView Grid.Row="1"
					  ItemsSource="{Binding ServerMessages}"
					  BorderBrush="{ThemeResource OutlineVariantColor}"
					  BorderThickness="1"
					  CornerRadius="8"
					  Background="{ThemeResource SurfaceBrush}">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="Padding" Value="0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate>
						<Grid Padding="14,10"
							  BorderBrush="{ThemeResource OutlineVariantColor}"
							  BorderThickness="0,0,0,1">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Margin="0,0,0,4">
								<TextBlock Text="{Binding Sender}"
										   FontWeight="SemiBold"
										   FontSize="12"
										   Foreground="{ThemeResource TertiaryColor}"
										   HorizontalAlignment="Left" />
								<TextBlock Text="{Binding TimeGmt}"
										   FontSize="10"
										   Opacity="0.55"
										   HorizontalAlignment="Right" />
							</Grid>
							<TextBlock Grid.Row="1"
									   Text="{Binding Message}"
									   TextWrapping="Wrap"
									   FontSize="13" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<!-- Reply Composer -->
			<Border Grid.Row="2"
					Background="{ThemeResource SurfaceBrush}"
					BorderBrush="{ThemeResource OutlineColor}"
					BorderThickness="0,1,0,0"
					Padding="12,10"
					Margin="0,8,0,0">
				<Grid ColumnSpacing="12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox Grid.Column="0"
							 x:Uid="ConversationDetailsPage_ReplyMessageTextBox"
							 Text="{Binding ReplyMessage, Mode=TwoWay}"
							 PlaceholderText="Antwort eingeben..."
							 AcceptsReturn="True"
							 MinHeight="60"
							 MaxHeight="120" />
					<Button Grid.Column="1"
							x:Uid="ConversationDetailsPage_SendReplyButton"
							Content="Senden"
							Command="{Binding SendReplyCommand}"
							VerticalAlignment="Bottom"
							MinWidth="90"
							Padding="14,10" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Page>
