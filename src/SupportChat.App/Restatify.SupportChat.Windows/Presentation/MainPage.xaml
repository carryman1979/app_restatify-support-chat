<Page x:Class="Restatify.SupportChat.Presentation.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Restatify.SupportChat.Presentation"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  mc:Ignorable="d"
	  xmlns:uen="using:Uno.Extensions.Navigation.UI"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  NavigationCacheMode="Required"
	  Background="{ThemeResource BackgroundBrush}">
	<Page.Resources>
		<local:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
		<local:BooleanToVisibilityConverter x:Key="VisibleWhenFalse" Invert="True" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Navigation Bar -->
		<utu:NavigationBar Content="{Binding Title}">
			<utu:NavigationBar.SecondaryCommands>
				<AppBarButton x:Uid="MainPage_SettingsButton" Icon="Setting" Label="Settings" Click="OnSettingsClick" />
				<AppBarButton x:Uid="MainPage_LogsButton" Icon="Document" Label="Logs" Click="OnLogsClick" />
			</utu:NavigationBar.SecondaryCommands>
		</utu:NavigationBar>

		<!-- Login View -->
		<ScrollViewer Grid.Row="1"
					  Visibility="{Binding IsLoggedOut, Converter={StaticResource VisibleWhenTrue}}"
					  VerticalScrollBarVisibility="Auto"
					  VerticalScrollMode="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  HorizontalScrollMode="Disabled">
			<Grid Padding="24,20" MinHeight="480">
				<Border Background="{ThemeResource SurfaceBrush}"
						CornerRadius="10"
						Padding="24"
						Margin="0,12"
						MaxWidth="480"
						MinWidth="320"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<StackPanel Spacing="16">
						<Image Source="{Binding LogoImageUri}"
							   Width="72"
							   Height="72"
							   Stretch="Uniform"
							   ImageFailed="OnLogoImageFailed"
							   HorizontalAlignment="Center" />
						<TextBlock x:Uid="MainPage_StaffLoginText"
								   Text="Staff Login"
								   FontSize="18"
								   FontWeight="SemiBold"
								   HorizontalAlignment="Center" />
						<TextBox x:Uid="MainPage_EmailTextBox"
								 Header="Benutzername oder E-Mail"
								 Text="{Binding Email, Mode=TwoWay}"
								 PlaceholderText="support@restatify.tech"
								 HorizontalAlignment="Stretch" />
						<PasswordBox x:Uid="MainPage_PasswordBox"
								 Header="Passwort"
								 PasswordRevealMode="Peek"
								 Password="{Binding Password, Mode=TwoWay}"
								 HorizontalAlignment="Stretch" />
						<CheckBox x:Uid="MainPage_RememberLoginCheckBox"
								  Content="Zugangsdaten speichern"
								  IsChecked="{Binding RememberLogin, Mode=TwoWay}" />
						<Button x:Uid="MainPage_LoginButton"
								Content="Login"
								Command="{Binding LoginCommand}"
								HorizontalAlignment="Stretch"
								Padding="12,10" />
						<Border Background="{ThemeResource PrimaryContainerColor}"
								CornerRadius="8"
								Padding="12"
								Margin="0,4,0,0">
							<StackPanel Spacing="6">
								<TextBlock x:Uid="MainPage_StatusText" Text="Status" FontWeight="SemiBold" FontSize="12" />
								<TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</Grid>
		</ScrollViewer>

		<!-- Logged-in View -->
		<Grid Grid.Row="1"
			  Visibility="{Binding IsLoggedIn, Converter={StaticResource VisibleWhenTrue}}"
			  Padding="24,16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Image Grid.Column="0"
					   Source="{Binding LogoImageUri}"
					   Width="32"
					   Height="32"
					   Stretch="Uniform"
					   ImageFailed="OnLogoImageFailed"
					   VerticalAlignment="Center" />
				<TextBlock Grid.Column="1"
						   x:Uid="MainPage_ConversationsText"
						   Text="Conversations"
						   FontSize="16"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
				<ProgressRing Grid.Column="2"
							  IsActive="{Binding IsRefreshingConversations}"
							  Visibility="{Binding IsRefreshingConversations, Converter={StaticResource VisibleWhenTrue}}"
							  Width="18"
							  Height="18"
							  VerticalAlignment="Center" />
				<Button Grid.Column="3"
						x:Uid="MainPage_LoadConversationsButton"
						Content="{Binding LoadConversationsButtonContent}"
						IsEnabled="{Binding CanRefreshConversations}"
						Command="{Binding LoadConversationsCommand}"
						Padding="10,7" />
				<Button Grid.Column="4"
						x:Uid="MainPage_LogoutButton"
						Content="Abmelden"
						Command="{Binding LogoutCommand}"
						Padding="10,7" />
			</Grid>

			<ListView Grid.Row="1"
					  ItemsSource="{Binding Conversations}"
					  SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
					  SelectionMode="Single"
					  BorderBrush="{ThemeResource OutlineColor}"
					  BorderThickness="1"
					  CornerRadius="8"
					  Background="{ThemeResource SurfaceBrush}">
				<ListView.ItemContainerTransitions>
					<TransitionCollection />
				</ListView.ItemContainerTransitions>
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate>
						<Border Background="{ThemeResource SurfaceBrush}"
								BorderBrush="{ThemeResource OutlineVariantColor}"
								BorderThickness="0,0,0,1"
								Padding="14,10">
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
									<TextBlock Text="{Binding Id}" FontWeight="SemiBold" FontSize="13" />
									<TextBlock Text="{Binding SourceUrl}"
											   FontSize="11"
											   Opacity="0.6"
											   TextWrapping="NoWrap"
											   TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<Border Grid.Column="1"
										Background="{ThemeResource TertiaryColor}"
										CornerRadius="10"
										Padding="8,4"
										VerticalAlignment="Center">
									<TextBlock Text="{Binding UnreadCount}"
											   Foreground="{ThemeResource OnTertiaryColor}"
											   FontSize="11"
											   FontWeight="SemiBold" />
								</Border>
							</Grid>
						</Border>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Button Grid.Row="2"
					x:Uid="MainPage_OpenChatButton"
					Content="Chat öffnen"
					Command="{Binding OpenConversationDetailsCommand}"
					HorizontalAlignment="Right"
					MinWidth="140"
					Padding="14,9"
					Margin="0,10,0,0" />
		</Grid>

		<!-- Status Bar -->
		<Border Grid.Row="2"
				Background="{ThemeResource SurfaceVariantColor}"
				BorderBrush="{ThemeResource OutlineVariantColor}"
				BorderThickness="0,1,0,0"
				Padding="14,5">
			<TextBlock Text="{Binding StatusBar}"
					   FontSize="11"
					   Opacity="0.7"
					   TextTrimming="CharacterEllipsis" />
		</Border>
	</Grid>
</Page>
